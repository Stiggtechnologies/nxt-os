  "dependencies": {
    "T4_employment_income_and_issuer": "Source string field15079 is split at its first space. The trimmed prefix is parsed as Decimal using InvariantCulture and NumberStyles511; the suffix is the issuer. PriorYear.M[1]/box14 and issuer are assigned only on successful parsing. Raw issuer text must not be used wholesale as an employer name.",
    "T4_province": "ListIndex12469 maps province of employment. Pensionable earnings selection separately depends on client ProvinceDec31: source13514 for Quebec, source13909 otherwise. The list-to-province conversion is another dependency, not a direct raw integer to ISO mapping.",
    "T5_allocation": "ListIndex14583 selects spousal(1) or third-party(2) allocation; target allocation is1 minus source.Allocation12462. Preserve gross source amounts and allocation evidence rather than silently netting values.",
    "T5_country": "ListIndex12457 passes through CountryFromValue; its raw list value is not established here as an ISO country code.",
    "source_accessor_semantics": "M/MSum absence, numeric decoding, repeated-subindex handling and default-zero behavior are not independently established by this report. A normalizer must preserve raw presence and never convert a missing field into verified zero."
  },
  "privacy_boundary": {
    "numeric_mapping_allowlist_only": true,
