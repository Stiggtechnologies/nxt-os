{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/main.rs": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/main"
    },
    {
      "source": "/r/:code",
      "destination": "/api/main"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/esign-sweep",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/firm-tick",
      "schedule": "15 * * * *"
    }
  ]
}
