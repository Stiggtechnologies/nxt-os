# Workspace sign-in. Leave unset only for a local open workspace.
ADMIN_API_KEY=

# Ask NXT, and Nixon's Claude engine when NIXON_ENGINE=claude.
ANTHROPIC_API_KEY=
NXT_AI_MODEL=claude-opus-5-5

# Optional HMAC secret for the referral widget.
WIDGET_SIGNING_SECRET=

# Upstash Redis from the Vercel integration. Omit both and data stays in memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# GuardVoice. With the Twilio values empty, the module stays in mock mode
# and never dials. Do not put real numbers or tokens in this file.
# GUARDVOICE_MODE=mock
# GUARDVOICE_TRANSPORT=relay
# GUARDVOICE_SIGNATURE_MODE=off
# GUARDVOICE_AUTONOMY=write
# NIXON_ENGINE=scripted
GUARDVOICE_AGENT_NAME=Nixon
GUARDVOICE_COMPANY_NAME=
GUARDVOICE_TIMEZONE=America/Toronto
GUARDVOICE_OWNER_SMS=
GUARDVOICE_FROM_NUMBER=
GUARDVOICE_TRANSFER_NUMBER=
GUARDVOICE_TRANSFER_NAME=
GUARDVOICE_LOOP_GUARD=
GUARDVOICE_PUBLIC_HOST=
GUARDVOICE_STREAM_SECRET=
GUARDVOICE_WELCOME=
GUARDVOICE_NOTES_WEBHOOK_URL=
GUARDVOICE_NOTES_WEBHOOK_SECRET=
GUARDVOICE_LANGUAGE=en-CA
GUARDVOICE_TTS_PROVIDER=Google
GUARDVOICE_TTS_VOICE=en-US-Neural2-F
GUARDVOICE_STT_PROVIDER=Deepgram

# Twilio. Leave blank until you mean to take live calls.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Stripe Checkout for Nixon guided T1 filing fee (pay-before-file). Default off.
# Never set NXT_STRIPE_LIVE_APPROVED. Use sk_test_ keys only. Do not commit secrets.
# NXT_STRIPE_ENABLED=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NXT_STRIPE_FEE_CENTS=19900
# NXT_STRIPE_CURRENCY=cad
# NXT_STRIPE_PRODUCT_NAME=T1 filing fee
# NXT_STRIPE_API_BASE=https://api.stripe.com
# NXT_PUBLIC_BASE_URL=https://os.nxtcorporation.ca
# NXT_STRIPE_SUCCESS_URL=
# NXT_STRIPE_CANCEL_URL=
# NXT_STRIPE_LIVE_APPROVED=

# God's Eye AI drafting (off unless GODS_EYE_AI=on). Watchers need none of these.
# Client/company data goes only to zero-retention AI Gateway hosts; NVIDIA free models get non-sensitive prompts only.
# GODS_EYE_AI=
# AI_GATEWAY_API_KEY=   (optional on Vercel: the x-vercel-oidc-token request header is used at runtime)
# GODS_EYE_MODELS=deepseek/deepseek-v4.1-flash-1017
# GODS_EYE_ZDR_PROVIDERS=fireworks,togetherai,baseten
# GODS_EYE_SENSITIVE_FALLBACK_MODELS=anthropic/claude-sonnet-5.5
# GODS_EYE_SENSITIVE_FALLBACK_PROVIDERS=anthropic,bedrock
# NVIDIA_API_KEY=
# NVIDIA_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b,nvidia/nemotron-3-super-120b-a12b,openai/gpt-oss-20b
